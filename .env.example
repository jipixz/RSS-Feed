# Base de datos SQLite (ruta relativa a prisma/schema.prisma)
DATABASE_URL="file:../data/senal.db"

# Proveedor de IA para TL;DR: ollama | anthropic | none
AI_PROVIDER=ollama

# Ollama (en otra máquina de tu red — usa un modelo de `ollama list`)
OLLAMA_BASE_URL=http://192.168.1.100:11434
OLLAMA_MODEL=gemma4:latest

# Anthropic (solo si AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Ingesta: cron de 6 campos (seg min hora díaMes mes díaSemana) — cada 30 min
INGEST_CRON=0 */30 * * * *

# Máximo de resúmenes IA por día (RN-05)
AI_DAILY_BUDGET=60

# Días de retención de artículos leídos y no guardados (RN-06)
RETENTION_DAYS=30

# Puerto de la app (API + frontend)
PORT=3001

# Interfaz de red. 0.0.0.0 = accesible desde la LAN (default).
# 127.0.0.1 = solo local; el tunnel de Cloudflare sigue funcionando y se cierra
# el acceso directo por IP de LAN (recomendado si SOLO usas el dominio del tunnel).
HOST=0.0.0.0

# Solo si expones la API fuera de tu red privada (protege los writes)
API_KEY=

# ── Audiolibro (TTS) ─────────────────────────────────────────────
# Piper (rápido, corre en la propia Pi): pip install piper-tts
# y descarga una voz .onnx de https://huggingface.co/rhasspy/piper-voices
TTS_PIPER_BIN=piper
TTS_PIPER_VOICE=/home/pi/RSS/senal/data/tts-voices/en_US-lessac-medium.onnx
# Kokoro (calidad, corre en la PC):
#   docker run -d -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu:latest
TTS_KOKORO_URL=http://192.168.1.50:8880
TTS_KOKORO_VOICE=af_heart
